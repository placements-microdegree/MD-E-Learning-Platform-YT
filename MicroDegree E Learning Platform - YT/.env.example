GRAPHY_API_KEY=

# Canonical public origin. Auth redirects (Supabase OAuth callback, SSO handoff) are pinned to this
# so they never leak the per-deploy Netlify permalink (e.g. https://<deploy-id>--<site>.netlify.app).
# On the microdegree.in deployment: https://microdegree.in
# On the deployment proxied at microdegree.work/learning: https://www.microdegree.work/learning
NEXT_PUBLIC_SITE_URL=

# Sub-path this app is served under, when it is not at the domain root. Leave BLANK for the
# microdegree.in deployment and local dev. Set to "/learning" for the deployment that
# microdegree.work reverse-proxies at microdegree.work/learning (Next.js basePath).
# Must be set at build time -- it is inlined into the client bundle.
NEXT_PUBLIC_BASE_PATH=

# /e-learning page (microdegree.work/e-learning): exact copy of the home page whose CTAs go to a
# different Graphy plan. Same deployment, no extra basePath -- just its own checkout links.
GRAPHY_E_LEARNING_CHECKOUT_URL=
GRAPHY_E_LEARNING_FREE_COURSE_URL=

# Organic (/tech-courses) checkout and free course links. Same idea as /e-learning above:
# an exact copy of the home page (microdegree.work/tech-courses) with its own Graphy plan.
GRAPHY_ORGANIC_CHECKOUT_URL=
GRAPHY_ORGANIC_FREE_COURSE_URL=

# Origin Google should treat as canonical (rel=canonical / metadataBase). Set this to
# https://www.microdegree.work/learning on BOTH deployments so all ranking signal consolidates
# on the microdegree.work primary domain. Falls back to NEXT_PUBLIC_SITE_URL when unset.
NEXT_PUBLIC_CANONICAL_ORIGIN=

# Where generic "Enroll Now" CTAs land post-login -  the learner's active courses/dashboard, not the bare domain.
GRAPHY_DASHBOARD_URL=

# Paid course bundle checkout (Razorpay via Graphy). Update this when the bundle/link changes.
GRAPHY_COURSE_CHECKOUT_URL=

# Free course link used by the "Start Learning for Free" plan card.
GRAPHY_FREE_COURSE_URL=

# Refer & earn link used by the referral section CTA.
GRAPHY_REFERRAL_URL=

# Supabase project -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anonymous visitor tracking (page views + WhatsApp / sign-up CTA clicks). These are the URL and
# anon key of the MAIN-site Supabase project (the one that holds the tracking_sessions /
# tracking_events tables and the track_batch() function), NOT this app's own project above.
# Both are public values (safe in the browser). Leave blank to switch tracking off. Set them on
# BOTH deployments (microdegree.in and the one proxied at microdegree.work/learning) and redeploy,
# because NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_TRACKING_SUPABASE_URL=
NEXT_PUBLIC_TRACKING_SUPABASE_ANON_KEY=

# Supabase project -> Settings -> API -> service_role secret. Server-only, bypasses RLS.
# Used by the Graphy webhook receiver and the CSV backfill script to write to arbitrary users' profiles.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret we choose ourselves and append to the Graphy webhook URL as ?secret=...
# (Graphy's "New Webhook" form has no header/signing field, so this is the only auth channel available.)
GRAPHY_WEBHOOK_SECRET=

# LeadSquared -> Settings (gear icon) -> API code generation. Used by app/api/webhooks/graphy-leads-crm
# and scripts/sync-graphy-leads-to-lsq.mjs to push graphy_leads rows into the CRM as leads.
LEADSQUARED_ACCESS_KEY=
LEADSQUARED_SECRET_KEY=

# Region/cluster-specific API host shown on that same Settings -> API page -  NOT the generic
# api.leadsquared.com for every account. e.g. api-in21.leadsquared.com. Host only, no https:// prefix.
LEADSQUARED_API_HOST=

# Shared secret we choose ourselves and append to the graphy-leads-crm webhook URL as ?secret=...
# (same reasoning as GRAPHY_WEBHOOK_SECRET -  Supabase Database Webhooks have no signing option either).
LEADSQUARED_WEBHOOK_SECRET=
